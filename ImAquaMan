        GuiLabel((Rectangle){px+12,*y,60,20},"Gravity");

        GuiSlider(
            (Rectangle){px+70,*y,panelWidth-140,20},
            NULL,NULL,
            &sim->guiGravity,
            -20.0f,
            0.0f
        );

        // gravity number display
        char buf[32];
        sprintf(buf,"%.2f",sim->guiGravity);

        DrawText(
            buf,
            px + panelWidth - 55,
            *y + 2,
            12,
            DARKGRAY
        );
    }
    else
    {
        char buf[64];
        sprintf(buf,"Gravity: %.2f",GRAVITY);
        DrawText(buf,px+12,*y,14,DARKGRAY);
    }

    *y += 32;
}


void draw_run_mode_controls(SimulationController *sim, int px, int *y, int panelWidth)
{
    DrawText("Run Mode",px+12,*y,14,DARKGRAY);
    *y += 18;

    if(sim->simState == CONFIGURATION)
    {
        GuiCheckBox((Rectangle){px+12,*y,20,20},"Timed Run",&sim->guiTimedRun);
        *y += 26;

        if(sim->guiTimedRun)
        {
            DrawText("Duration (s)",px+12,*y,12,DARKGRAY);

            GuiSlider(
                (Rectangle){px+12,*y+14,panelWidth-24,18},
                NULL,NULL,
                &sim->guiRunDuration,
                0.5f,
                600.0f
            );

            *y += 36;
        }
    }

    else
    {
        char buf[64];

        if(sim->guiTimedRun)
            sprintf(buf,"Timed: %.1f s",sim->guiRunDuration);
        else
            sprintf(buf,"Continuous");

        DrawText(buf,px+12,*y,12,DARKGRAY);

        *y += 26;
    }
}



void draw_ball_controls(SimulationController *sim, int px, int *y, int panelWidth, int screenHeight)
{
    for(int i = 0; i < sim->guiBallCount; i++)
    {
        char title[32];
        sprintf(title,"Ball %d", i+1);
        DrawText(title, px+12, *y, 14, DARKGRAY);
        *y += 18;

        if(sim->simState == CONFIGURATION)
        {
            draw_mass_control(sim, i, px, y, panelWidth);
            draw_radius_control(sim, i, px, y, panelWidth);

            draw_velocity_mode_toggle(sim, i, px, y);

            if(sim->gui_use_speedangle[i])
                draw_speed_angle_controls(sim, i, px, y, panelWidth);
            else
                draw_velocity_vector_controls(sim, i, px, y, panelWidth);
        }

        if(*y > screenHeight - 120)
        {
            DrawText("More controls below...", px+12, screenHeight-100, 10, DARKGRAY);
            break;
        }
    }
}


void draw_energy_display(SimulationController *sim, int px, int screenHeight)
{
    float ke = 0;
    float pe = 0;

    Ball *balls =
        (sim->simState == RUNNING)
        ? sim->simBalls
        : sim->guiBalls;

    for(int i=0;i<sim->guiBallCount;i++)
    {
        ke += kinetic_energy(&balls[i]);
        pe += potential_energy(&balls[i]);
    }

    char buf[128];

    sprintf(
        buf,
        "KE: %.2f J  PE: %.2f J  Total: %.2f J",
        ke,pe,ke+pe
    );

    DrawText(buf,px+12,screenHeight-30,12,DARKGRAY);
}




// ---------------------- Main run function ---------------------------------
void run_raylib_simulation(Ball initialBalls[], float dt, int max_frames)
{
    SimulationController sim = {0};

    sim.simState = CONFIGURATION;
    sim.paused = false;
    sim.show_vectors = true;
    sim.slow_motion = false;
    sim.slow_factor = 0.2f;

    sim.simElapsed = 0.0f;
    sim.guiTimedRun = false;
    sim.guiRunDuration = 10.0f;

    sim.guiBallCount = (num_balls > 0) ? num_balls : 1;

    for (int i = 0; i < MAX_BALLS; i++)
    {
        if (initialBalls != NULL && i < num_balls && initialBalls[i].radius > 0)
        {
            sim.guiBalls[i] = initialBalls[i];
        }
        else
        {
            sim.guiBalls[i].x = WIDTH/2.0f + i*2.0f;
            sim.guiBalls[i].y = HEIGHT/2.0f;
            sim.guiBalls[i].velocityx = 0;
            sim.guiBalls[i].velocityy = 0;
            sim.guiBalls[i].mass = 1.0f;
            sim.guiBalls[i].restitution = 0.8f;
            sim.guiBalls[i].radius = 0.5f;
        }

        sim.simBalls[i] = sim.guiBalls[i];
        sim.savedInitialBalls[i] = sim.guiBalls[i];

        sim.gui_use_speedangle[i] = true;

        sim.gui_speed[i] =
            sqrtf(sim.guiBalls[i].velocityx * sim.guiBalls[i].velocityx +
                  sim.guiBalls[i].velocityy * sim.guiBalls[i].velocityy);

        sim.gui_angle_deg[i] =
            atan2f(sim.guiBalls[i].velocityy, sim.guiBalls[i].velocityx)
            * 180.0f / M_PI;
    }

    sim.guiGravity = GRAVITY;

    reset_trails_for_num(sim.guiBallCount);

    const int screenWidth = 1024;
    const int screenHeight = 720;
    const int panelWidth = 320;
    const int simWidth = screenWidth - panelWidth;

    InitWindow(screenWidth, screenHeight, "Multi-Ball Physics Simulator");
    SetTargetFPS(60);

    float scaleX = (float)simWidth / (float)WIDTH;
    float scaleY = (float)screenHeight / (float)HEIGHT;

    int frame = 0;

    while (!WindowShouldClose() && (max_frames <= 0 || frame < max_frames))
    {
        if (IsKeyPressed(KEY_V)) sim.show_vectors = !sim.show_vectors;
        if (IsKeyPressed(KEY_S)) sim.slow_motion = !sim.slow_motion;
        if (IsKeyPressed(KEY_SPACE) && sim.simState == RUNNING)
            sim.paused = !sim.paused;

        if (sim.simState == RUNNING && !sim.paused)
        {
            float effective_dt = dt;

            if (sim.slow_motion)
                effective_dt *= sim.slow_factor;

            int substeps = 4;
            float sub_dt = effective_dt / (float)substeps;

            for (int s = 0; s < substeps; s++)
                simulation_step(sim.simBalls, sim.guiBallCount, sub_dt);

            if (sim.guiTimedRun)
            {
                sim.simElapsed += effective_dt;

                if (sim.simElapsed >= sim.guiRunDuration)
                {
                    sim.simState = CONFIGURATION;
                    sim.paused = false;

                    for (int i = 0; i < sim.guiBallCount; i++)
                    {
                        sim.guiBalls[i] = sim.savedInitialBalls[i];
                        sim.simBalls[i] = sim.savedInitialBalls[i];
                    }

                    sim.simElapsed = 0;
                }
            }

            for (int b = 0; b < sim.guiBallCount; b++)
                update_trail(&sim.simBalls[b], b);
        }

        BeginDrawing();
        ClearBackground(RAYWHITE);

        DrawRectangle(0,0,simWidth,screenHeight,LIGHTGRAY);

        Ball *drawBalls =
            (sim.simState == RUNNING) ? sim.simBalls : sim.guiBalls;

        for (int i = 0; i < sim.guiBallCount; i++)
        {
            float x = drawBalls[i].x * scaleX;
            float y = screenHeight - drawBalls[i].y * scaleY;

            float r =
                drawBalls[i].radius * ((scaleX + scaleY) * 0.5f);

            DrawCircle((int)x,(int)y,r,RED);

            if (sim.show_vectors)
            {
                float vx = drawBalls[i].velocityx;
                float vy = drawBalls[i].velocityy;

                // When configuring using speed/angle we must convert it
                if (sim.simState == CONFIGURATION && sim.gui_use_speedangle[i])
                {
                    float angle = DEG2RAD * sim.gui_angle_deg[i];

                    vx = sim.gui_speed[i] * cosf(angle);
                    vy = sim.gui_speed[i] * sinf(angle);
                }

                vx *= 5;
                vy *= -5;

                DrawLine(x, y, x + vx, y + vy, BLUE);

                float ax = 0;
                float ay = sim.guiGravity * 2;

                DrawLine(x, y, x + ax, y - ay, GREEN);
            }
        }

        draw_control_panel(&sim, simWidth, screenHeight, panelWidth);

        EndDrawing();

        frame++;
    }

    CloseWindow();
}




