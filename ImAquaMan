{
    Ball balls[MAX_BALLS] = {0};
    // start with one ball by default; GUI will let user add more
    num_balls = 1;

    float dt = 1.0f / 60.0f;

    // pass max_frames = 0 to run until window closed
    run_raylib_simulation(balls, dt, 0);

