typedef struct
{
    SimulationState simState;

    bool paused;
    bool show_vectors;
    bool slow_motion;
    float slow_factor;

    Ball guiBalls[MAX_BALLS];
    Ball simBalls[MAX_BALLS];
    Ball savedInitialBalls[MAX_BALLS];

    float gui_speed[MAX_BALLS];
    float gui_angle_deg[MAX_BALLS];

    bool gui_use_speedangle[MAX_BALLS];

    int guiBallCount;

    float guiGravity;

    bool guiTimedRun;
    float guiRunDuration;

    float simElapsed;

} SimulationController;


// ---------------------- Helper: Physics update -----------------------------
void update_physics(SimulationController *sim, float dt)
{
    if (sim->simState != RUNNING || sim->paused) return;

    float effective_dt = dt;
    if (sim->slow_motion) effective_dt *= 0.2f;

    int substeps = 4;
    float sub_dt = effective_dt / (float)substeps;

    for (int s = 0; s < substeps; s++)
        simulation_step(sim->simBalls, sim->guiBallCount, sub_dt);

    if (sim->guiTimedRun) {
        sim->simElapsed += dt;
        if (sim->simElapsed >= sim->guiRunDuration) {
            // stop simulation and restore GUI
            sim->simState = CONFIGURATION;
            sim->paused = false;
            for (int i = 0; i < sim->guiBallCount; i++) {
                sim->guiBalls[i] = sim->savedInitialBalls[i];
                sim->gui_speed[i] = sqrtf(sim->guiBalls[i].velocityx*sim->guiBalls[i].velocityx +
                                          sim->guiBalls[i].velocityy*sim->guiBalls[i].velocityy);
                sim->gui_angle_deg[i] = atan2f(sim->guiBalls[i].velocityy, sim->guiBalls[i].velocityx) * 180.0f / M_PI;
                sim->gui_use_speedangle[i] = true;
                sim->simBalls[i] = sim->guiBalls[i];
            }
            reset_trails_for_num(sim->guiBallCount);
            sim->simElapsed = 0.0f;
        }
    }
}

// ---------------------- Helper: Input --------------------------------------
void handle_input(SimulationController *sim)
{
    if (IsKeyPressed(KEY_V)) sim->show_vectors = !sim->show_vectors;
    if (IsKeyPressed(KEY_S)) sim->slow_motion = !sim->slow_motion;
    if (IsKeyPressed(KEY_SPACE) && sim->simState == RUNNING) sim->paused = !sim->paused;
}

// ---------------------- Helper: Draw simulation ----------------------------
void draw_simulation_area(SimulationController *sim, int simWidth, int screenHeight)
{
    float scaleX = (float)simWidth / (float)WIDTH;
    float scaleY = (float)screenHeight / (float)HEIGHT;

    // Simulation background
    DrawRectangle(0, 0, simWidth, screenHeight, LIGHTGRAY);
    DrawLine(0, screenHeight, simWidth, screenHeight, BLACK);
    DrawLine(0, 0, 0, screenHeight, BLACK);
    DrawLine(simWidth - 1, 0, simWidth - 1, screenHeight, BLACK);

    // Trails
    for (int b = 0; b < sim->guiBallCount; b++) {
        for (int t = 0; t < TRAIL_LENGTH; t++) {
            if (trail_x[b][t] < 0) continue;
            int px_t = (int)(trail_x[b][t] * scaleX);
            int py_t = (int)(screenHeight - trail_y[b][t] * scaleY);
            if (px_t >= 0 && px_t < simWidth && py_t >= 0 && py_t < screenHeight) DrawCircle(px_t, py_t, 2.0f, GRAY);
        }
    }

    // Balls
    Ball *drawBalls = (sim->simState == RUNNING) ? sim->simBalls : sim->guiBalls;
    for (int i = 0; i < sim->guiBallCount; i++) {
        float x = drawBalls[i].x * scaleX;
        float y = screenHeight - drawBalls[i].y * scaleY;
        float radius_pixels = drawBalls[i].radius * ((scaleX + scaleY) * 0.5f);
        DrawCircle((int)x, (int)y, radius_pixels, RED);

        if (sim->show_vectors) {
            float velocity_scale = 5.0f;
            float vx = drawBalls[i].velocityx * velocity_scale;
            float vy = -drawBalls[i].velocityy * velocity_scale;
            DrawLine((int)x, (int)y, (int)(x + vx), (int)(y + vy), BLUE);

            float accel_scale = 2.0f;
            float ax = 0;
            float ay = sim->guiGravity * accel_scale;
            DrawLine((int)x, (int)y, (int)(x + ax), (int)(y - ay), GREEN);
        }
    }
}

