/**
 * Draws + and - buttons to add or remove balls (CONFIGURATION only).
 * In RUNNING mode, shows a read-only ball count label instead.
 * Advances *y past the control.
 */
void draw_ball_count_controls(SimulationController *sim, int px, int *y) {
    DrawText("Ball count", px + 12, *y, 12, DARKGRAY);
    *y += 18;

    if (sim->simState == CONFIGURATION) {
        if (GuiButton((Rectangle){px+12, *y, 40, 24}, "-") && sim->guiBallCount > 1) {
            sim->guiBallCount--;
            reset_trails_for_num(sim->guiBallCount);
        }

        if (GuiButton((Rectangle){px+60, *y, 40, 24}, "+") && sim->guiBallCount < MAX_BALLS) {
            int k = sim->guiBallCount;

            sim->guiBalls[k].x           = WIDTH/2.0f + k*2.0f;
            sim->guiBalls[k].y           = HEIGHT/2.0f;
            sim->guiBalls[k].mass        = 1.0f;
            sim->guiBalls[k].restitution = 0.8f;
            sim->guiBalls[k].radius      = 0.5f;
            sim->guiBalls[k].velocityx   = 0;
            sim->guiBalls[k].velocityy   = 0;

            sim->savedInitialBalls[k] = sim->guiBalls[k];
            sim->gui_speed[k]         = 0;
            sim->gui_angle_deg[k]     = 0;

            sim->guiBallCount++;
            reset_trails_for_num(sim->guiBallCount);
        }

        char buf[16];
        sprintf(buf, "%d", sim->guiBallCount);
        DrawText(buf, px+110, *y+2, 20, DARKGRAY);
    }
    else {
        char buf[32];
        sprintf(buf, "Balls: %d", sim->guiBallCount);
        DrawText(buf, px+12, *y+2, 14, DARKGRAY);
    }

    *y += 34;
}

/**
 * Draws Start / Pause / Stop controls.
 *
 * In CONFIGURATION mode:
 *   - Start: converts speed/angle inputs to vx/vy, copies guiBalls to simBalls,
 *     applies the gravity setting globally, and transitions to RUNNING.
 *   - Pause: disabled (greyed out).
 *   - Reset: restores guiBalls from the saved initial snapshot.
 *
 * In RUNNING mode:
 *   - Start: disabled ("Running..." label).
 *   - Pause / Resume: toggles the paused flag.
 *   - Stop & Edit: transitions back to CONFIGURATION and restores all balls.
 *
 * Advances *y past all three buttons.
 */
void draw_simulation_buttons(SimulationController *sim, int px, int *y, int panelWidth) {
    int btnW = panelWidth - 24;
    int btnH = 28;

    Rectangle start = {px+12, *y, btnW, btnH}; *y += btnH + 8;
    Rectangle pause = {px+12, *y, btnW, btnH}; *y += btnH + 8;
    Rectangle reset = {px+12, *y, btnW, btnH}; *y += btnH + 12;

    if (sim->simState == CONFIGURATION) {
        if (GuiButton(start, "Start")) {
            for (int i = 0; i < sim->guiBallCount; i++) {
                if (sim->gui_use_speedangle[i]) {
                    float a = sim->gui_angle_deg[i] * (float)M_PI / 180.0f;
                    sim->guiBalls[i].velocityx = sim->gui_speed[i] * cosf(a);
                    sim->guiBalls[i].velocityy = sim->gui_speed[i] * sinf(a);
                }
                sim->simBalls[i] = sim->guiBalls[i];
            }

            GRAVITY         = sim->guiGravity;
            sim->simState   = RUNNING;
            sim->paused     = false;
            reset_trails_for_num(sim->guiBallCount);
        }

        GuiSetState(STATE_DISABLED);
        GuiButton(pause, "Pause");
        GuiSetState(STATE_NORMAL);

        if (GuiButton(reset, "Reset")) {
            for (int i = 0; i < sim->guiBallCount; i++)
                sim->guiBalls[i] = sim->savedInitialBalls[i];
        }
    }
    else {
        GuiSetState(STATE_DISABLED);
        GuiButton(start, "Running...");
        GuiSetState(STATE_NORMAL);

        if (GuiButton(pause, sim->paused ? "Resume" : "Pause"))
            sim->paused = !sim->paused;

        if (GuiButton(reset, "Stop & Edit")) {
            sim->simState = CONFIGURATION;
            sim->paused   = false;
            for (int i = 0; i < sim->guiBallCount; i++) {
                sim->guiBalls[i] = sim->savedInitialBalls[i];
                sim->simBalls[i] = sim->savedInitialBalls[i];
            }
        }
    }
}

/**
 * Draws the gravity slider (CONFIGURATION only) or a read-only gravity label
 * (RUNNING). Advances *y past the control.
 */
void draw_global_controls(SimulationController *sim, int px, int *y, int panelWidth) {
    DrawText("Global", px+12, *y, 14, DARKGRAY);
    *y += 18;

    if (sim->simState == CONFIGURATION) {
        GuiLabel((Rectangle){px+12, *y, 60, 20}, "Gravity");

        GuiSlider((Rectangle){px+70, *y, panelWidth-140, 20},
                  NULL, NULL, &sim->guiGravity, -20.0f, 0.0f);

        char buf[32];
        sprintf(buf, "%.2f", sim->guiGravity);
        DrawText(buf, px+panelWidth-55, *y+2, 12, DARKGRAY);
    }
    else {
        char buf[64];
        sprintf(buf, "Gravity: %.2f", GRAVITY);
        DrawText(buf, px+12, *y, 14, DARKGRAY);
    }

    *y += 32;
}

/**
 * Draws the timed-run checkbox and, if enabled, a duration slider.
 * In RUNNING mode shows a read-only status label instead.
 * Advances *y past the control.
 */
void draw_run_mode_controls(SimulationController *sim, int px, int *y, int panelWidth) {
    DrawText("Run Mode", px+12, *y, 14, DARKGRAY);
    *y += 18;

    if (sim->simState == CONFIGURATION) {
        GuiCheckBox((Rectangle){px+12, *y, 20, 20}, "Timed Run", &sim->guiTimedRun);
        *y += 26;

        if (sim->guiTimedRun) {
            DrawText("Duration (s)", px+12, *y, 12, DARKGRAY);

            GuiSlider((Rectangle){px+12, *y+14, panelWidth-24, 18},
                      NULL, NULL, &sim->guiRunDuration, 0.5f, 600.0f);

            *y += 36;
        }
    }
    else {
        char buf[64];
        sprintf(buf, sim->guiTimedRun ? "Timed: %.1f s" : "Continuous", sim->guiRunDuration);
        DrawText(buf, px+12, *y, 12, DARKGRAY);
        *y += 26;
    }
}

/**
 * Draws a vertically scrollable list of per-ball configuration controls.
 *
 * Clipping:
 *   BeginScissorMode restricts rendering to the available vertical space
 *   below the fixed controls and above the energy bar, so controls that
 *   scroll out of view are hidden cleanly.
 *
 * Scrolling:
 *   Mouse wheel movement over the panel adjusts guiScrollOffset.
 *   The offset is clamped between 0 and (content_h - visible_h).
 *   A thin scrollbar on the right edge gives visual feedback.
 *
 * In CONFIGURATION mode, full sliders are shown for each ball.
 * In RUNNING mode, a compact read-only velocity readout is shown instead.
 *
 * Advances *y to screenHeight - 40 to reserve space for the energy bar.
 */
void draw_ball_controls(SimulationController *sim, int px, int *y, int panelWidth, int screenHeight) {
    int clipTop    = *y;
    int clipHeight = screenHeight - clipTop - 40;

    // Scroll on mouse wheel when cursor is over the panel
    Vector2 mouse = GetMousePosition();
    if (mouse.x > px) {
        sim->guiScrollOffset -= GetMouseWheelMove() * 30.0f;
        if (sim->guiScrollOffset < 0) sim->guiScrollOffset = 0.0f;
    }

    float content_h  = sim->guiBallCount * BALL_PANEL_HEIGHT_PER_BALL;
    float max_scroll = content_h - clipHeight;
    if (max_scroll < 0) max_scroll = 0;
    if (sim->guiScrollOffset > max_scroll) sim->guiScrollOffset = max_scroll;

    BeginScissorMode(px, clipTop, panelWidth, clipHeight);

    int draw_y = clipTop - (int)sim->guiScrollOffset;

    for (int i = 0; i < sim->guiBallCount; i++) {
        char title[32];
        sprintf(title, "Ball %d", i + 1);
        DrawText(title, px+12, draw_y, 14, DARKBLUE);
        draw_y += 20;

        if (sim->simState == CONFIGURATION) {
            draw_mass_control(sim, i, px, &draw_y, panelWidth);
            draw_radius_control(sim, i, px, &draw_y, panelWidth);
            draw_restitution_control(sim, i, px, &draw_y, panelWidth);
            draw_velocity_mode_toggle(sim, i, px, &draw_y);

            if (sim->gui_use_speedangle[i])
                draw_speed_angle_controls(sim, i, px, &draw_y, panelWidth);
            else
                draw_velocity_vector_controls(sim, i, px, &draw_y, panelWidth);
        }
        else {
            char buf[64];
            sprintf(buf, "vx=%.1f  vy=%.1f", sim->simBalls[i].velocityx, sim->simBalls[i].velocityy);
            DrawText(buf, px+12, draw_y, 12, DARKGRAY);
            draw_y += 18;
        }

        draw_y += 10;
    }

    EndScissorMode();

    // Scrollbar thumb
    if (max_scroll > 0) {
        float track_h = (float)clipHeight;
        float thumb_h = track_h * ((float)clipHeight / content_h);
        float thumb_y = clipTop + (sim->guiScrollOffset / max_scroll) * (track_h - thumb_h);

        DrawRectangle(px + panelWidth - 6, clipTop,       5, (int)track_h, Fade(GRAY, 0.3f));
        DrawRectangle(px + panelWidth - 6, (int)thumb_y,  5, (int)thumb_h, DARKGRAY);
    }

    *y = screenHeight - 40;
}

/**
 * Draws the energy readout bar at the bottom of the control panel.
 * Shows total kinetic energy, potential energy, and their sum across all balls.
 * Uses simBalls when running and guiBalls when in configuration.
 */
void draw_energy_display(SimulationController *sim, int px, int screenHeight) {
    Ball *balls = (sim->simState == RUNNING) ? sim->simBalls : sim->guiBalls;

    float ke = 0, pe = 0;
    for (int i = 0; i < sim->guiBallCount; i++) {
        ke += kinetic_energy(&balls[i]);
        pe += potential_energy(&balls[i]);
    }

    char buf[128];
    sprintf(buf, "KE: %.2f J  PE: %.2f J  Total: %.2f J", ke, pe, ke + pe);
    DrawText(buf, px+12, screenHeight-30, 12, DARKGRAY);
}

// ============================================================================
// CONTROL PANEL — TOP LEVEL
// ============================================================================

/**
 * Draws the full right-hand control panel by calling each section in order.
 * Sections share a running y coordinate so they stack vertically.
 */
void draw_control_panel(SimulationController *sim, int simWidth, int screenHeight, int panelWidth) {
    int px = simWidth;
    int y  = 36;

    draw_panel_background(px, screenHeight, panelWidth);
    draw_ball_count_controls(sim, px, &y);
    draw_simulation_buttons(sim, px, &y, panelWidth);
    draw_global_controls(sim, px, &y, panelWidth);
    draw_run_mode_controls(sim, px, &y, panelWidth);
    draw_ball_controls(sim, px, &y, panelWidth, screenHeight);
    draw_energy_display(sim, px, screenHeight);
}

// ============================================================================
// ENTRY POINT
// ============================================================================

/**
 * Program entry point.
 *
 * Sets up the window and runs the main loop:
 *   1. Handle keyboard input.
 *   2. Advance physics (if running and not paused).
 *   3. Draw simulation area (left panel).
 *   4. Draw control panel (right panel).
 *
 * The loop runs until the window is closed or max_frames is reached
 * (pass 0 for max_frames to run indefinitely).
 */
int main(void) {
    const int screenWidth  = 1024;
    const int screenHeight = 720;
    const int panelWidth   = 320;
    const int simWidth     = screenWidth - panelWidth;

    float dt = 1.0f / 60.0f;

    SimulationController sim = {0};
    init_simulation_controller(&sim);

    InitWindow(screenWidth, screenHeight, "Multi-Ball Physics Simulator");
    SetTargetFPS(60);

    while (!WindowShouldClose()) {
        handle_input(&sim);
        update_physics(&sim, dt);

        BeginDrawing();
        ClearBackground(RAYWHITE);

        draw_simulation_area(&sim, simWidth, screenHeight);
        draw_control_panel(&sim, simWidth, screenHeight, panelWidth);

        EndDrawing();
    }

    CloseWindow();
    return 0;
}
