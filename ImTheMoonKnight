
#include <math.h>
#include <stdio.h>
#include <stdbool.h>

// ============================================================================
// CONSTANTS
// ============================================================================

#define WIDTH        40     // Width of the simulation box (metres)
#define HEIGHT       20     // Height of the simulation box (metres)
#define TRAIL_LENGTH 200    // Number of trail positions stored per ball
#define MAX_BALLS    5      // Maximum number of balls in the simulation

// ============================================================================
// GLOBAL STATE
// ============================================================================

extern float GRAVITY;                           // Acceleration due to gravity (m/s^2), negative = downward
extern int   trail_x[MAX_BALLS][TRAIL_LENGTH];  // X-coordinates of trail positions per ball
extern int   trail_y[MAX_BALLS][TRAIL_LENGTH];  // Y-coordinates of trail positions per ball
extern int   trail_index[MAX_BALLS];            // Current write index in the circular trail buffer

// ============================================================================
// DATA STRUCTURES
// ============================================================================

/**
 * Represents a single ball in the simulation.
 * Positions and velocities are in metres and metres/second.
 * Forces accumulate each frame and are reset after integration.
 */
typedef struct {
    float x;           // Current X position (m)
    float y;           // Current Y position (m)
    float velocityx;   // Velocity in X direction (m/s)
    float velocityy;   // Velocity in Y direction (m/s)
    float mass;        // Mass (kg)
    float forcex;      // Accumulated force in X direction (N) — reset each frame
    float forcey;      // Accumulated force in Y direction (N) — reset each frame
    float restitution; // Coefficient of restitution (0 = no bounce, 1 = perfect bounce)
    float radius;      // Radius of the ball (m)
} Ball;

// ============================================================================
// FUNCTION PROTOTYPES
// ============================================================================

// Trail
void reset_trails_for_num(int n);
void update_trail(Ball *b, int ball_index);

// Physics
void apply_gravity(Ball *b);
void update_ball(Ball *b, float dt);
void check_wall_collisions(Ball *b);
void check_ball_collisions(Ball balls[], int num_balls);
void simulation_step(Ball balls[], int num_balls, float dt);

// Analysis
float kinetic_energy(Ball *b);
float potential_energy(Ball *b);
float total_energy(Ball *b);

// ============================================================================
// GLOBAL STATE DEFINITIONS
// ============================================================================

float GRAVITY = -9.8f;

int trail_x[MAX_BALLS][TRAIL_LENGTH];
int trail_y[MAX_BALLS][TRAIL_LENGTH];
int trail_index[MAX_BALLS];

// ============================================================================
// TRAIL
// ============================================================================

/**
 * Resets trail buffers for the first n balls.
 * All positions are set to -1 (invalid) and write indices reset to 0.
 * Call this whenever the ball count changes or a simulation restarts.
 */
void reset_trails_for_num(int n) {
    for (int b = 0; b < n; b++) {
        for (int i = 0; i < TRAIL_LENGTH; i++) {
            trail_x[b][i] = -1;
            trail_y[b][i] = -1;
        }
        trail_index[b] = 0;
    }
}

/**
 * Records the ball's current position into its circular trail buffer.
 * The write index wraps around once it reaches TRAIL_LENGTH,
 * overwriting the oldest position.
 */
void update_trail(Ball *b, int ball_index) {
    trail_x[ball_index][trail_index[ball_index]] = (int)b->x;
    trail_y[ball_index][trail_index[ball_index]] = (int)b->y;
    trail_index[ball_index]++;
    if (trail_index[ball_index] >= TRAIL_LENGTH)
        trail_index[ball_index] = 0;
}

// ============================================================================
// PHYSICS
// ============================================================================

/**
 * Accumulates gravitational force onto a ball using Newton's second law:
 *     F = m * g
 * Forces are kept separate so additional forces (e.g. drag, wind)
 * can be added each frame before integration.
 */
void apply_gravity(Ball *b) {
    b->forcey += b->mass * GRAVITY;
}

/**
 * Integrates forces into velocity and position using Euler integration:
 *     a  = F / m
 *     v += a * dt
 *     x += v * dt
 * Forces are reset to zero after integration ready for the next frame.
 */
void update_ball(Ball *b, float dt) {
    float ax = b->forcex / b->mass;
    float ay = b->forcey / b->mass;

    b->velocityx += ax * dt;
    b->velocityy += ay * dt;
    b->x         += b->velocityx * dt;
    b->y         += b->velocityy * dt;

    b->forcex = 0;
    b->forcey = 0;
}

/**
 * Resolves collisions between a ball and the four simulation boundaries.
 *
 * Left / right walls and floor:
 *   - Position is clamped to keep the ball inside.
 *   - Velocity component is reversed and scaled by restitution.
 *   - On the floor, very small vertical velocities are zeroed to
 *     prevent infinite low-energy jitter.
 *
 * Ceiling:
 *   - Same as walls — restitution applied for consistency.
 */
void check_wall_collisions(Ball *b) {
    // LEFT WALL
    if (b->x <= b->radius) {
        b->x        = b->radius;
        b->velocityx = -b->velocityx * b->restitution;
    }

    // RIGHT WALL
    if (b->x >= WIDTH - b->radius) {
        b->x        = WIDTH - b->radius;
        b->velocityx = -b->velocityx * b->restitution;
    }

    // FLOOR
    if (b->y <= b->radius) {
        b->y        = b->radius;
        b->velocityy = -b->velocityy * b->restitution;

        if (fabs(b->velocityy) < 0.1f)
            b->velocityy = 0;
    }

    // CEILING
    if (b->y >= HEIGHT - b->radius) {
        b->y        = HEIGHT - b->radius;
        b->velocityy = -b->velocityy * b->restitution;
    }
}

/**
 * Resolves collisions between every pair of balls.
 *
 * For each overlapping pair:
 *   1. Compute the collision normal from centre-to-centre direction.
 *   2. Calculate the relative velocity along that normal.
 *   3. Apply the impulse formula derived from conservation of momentum:
 *          p = 2 * dot(v_rel, n) / (m_i + m_j)
 *      and update both velocities.
 *   4. Apply a position correction to push the balls apart by the overlap
 *      amount, preventing them from tunnelling into each other over
 *      multiple frames.
 */
void check_ball_collisions(Ball balls[], int num_balls) {
    for (int i = 0; i < num_balls; i++) {
        for (int j = i + 1; j < num_balls; j++) {
            float dx       = balls[j].x - balls[i].x;
            float dy       = balls[j].y - balls[i].y;
            float distance = sqrtf(dx*dx + dy*dy);
            float min_dist = balls[i].radius + balls[j].radius;

            if (distance >= min_dist || distance == 0) continue;

            float nx = dx / distance;
            float ny = dy / distance;

            // Impulse scalar from momentum conservation
            float p = 2.0f * (balls[i].velocityx*nx + balls[i].velocityy*ny
                            - balls[j].velocityx*nx - balls[j].velocityy*ny)
                    / (balls[i].mass + balls[j].mass);

            balls[i].velocityx -= p * balls[j].mass * nx;
            balls[i].velocityy -= p * balls[j].mass * ny;
            balls[j].velocityx += p * balls[i].mass * nx;
            balls[j].velocityy += p * balls[i].mass * ny;

            // Position correction — push balls apart by half the overlap each
            float overlap = min_dist - distance;
            balls[i].x   -= nx * overlap * 0.5f;
            balls[i].y   -= ny * overlap * 0.5f;
            balls[j].x   += nx * overlap * 0.5f;
            balls[j].y   += ny * overlap * 0.5f;
        }
    }
}

/**
 * Advances the simulation by one timestep for all balls:
 *   1. Apply gravity to accumulate force.
 *   2. Integrate forces into velocity and position.
 *   3. Resolve wall and ceiling collisions.
 * Then, once all balls are updated, resolve ball-to-ball collisions
 * and record trail positions with the final post-collision positions.
 */
void simulation_step(Ball balls[], int num_balls, float dt) {
    for (int i = 0; i < num_balls; i++) {
        apply_gravity(&balls[i]);
        update_ball(&balls[i], dt);
        check_wall_collisions(&balls[i]);
    }

    check_ball_collisions(balls, num_balls);

    // Trail update happens after all physics so positions are fully resolved
    for (int i = 0; i < num_balls; i++)
        update_trail(&balls[i], i);
}

// ============================================================================
// ANALYSIS
// ============================================================================

/**
 * Returns the kinetic energy of a ball:
 *     KE = 0.5 * m * (vx^2 + vy^2)
 */
float kinetic_energy(Ball *b) {
    return 0.5f * b->mass * (b->velocityx*b->velocityx + b->velocityy*b->velocityy);
}

/**
 * Returns the gravitational potential energy of a ball:
 *     PE = m * |g| * y
 * Uses fabs(GRAVITY) so PE is always positive regardless of GRAVITY's sign.
 */
float potential_energy(Ball *b) {
    return b->mass * fabsf(GRAVITY) * b->y;
}

/**
 * Returns the total mechanical energy of a ball:
 *     TE = KE + PE
 * Useful for verifying energy conservation — total should decrease
 * slowly due to restitution losses and stay stable between bounces.
 */
float total_energy(Ball *b) {
    return kinetic_energy(b) + potential_energy(b);
}




#define RAYGUI_IMPLEMENTATION
#include "raylib.h"
#include "raygui.h"

// ============================================================================
// CONSTANTS
// ============================================================================

#define BALL_PANEL_HEIGHT_PER_BALL 220.0f  // Estimated pixel height per ball in the scroll panel

// ============================================================================
// DATA STRUCTURES
// ============================================================================

typedef enum {
    CONFIGURATION,  // User is setting up the simulation
    RUNNING         // Simulation is actively playing
} SimulationState;

/**
 * Holds all GUI and simulation state for the running session.
 * Separating this into a struct avoids global variables and makes
 * it easy to reset or inspect the full simulation state at once.
 */
typedef struct {
    SimulationState simState;

    bool  paused;        // Whether the simulation is currently paused
    bool  show_vectors;  // Whether velocity and acceleration vectors are drawn
    bool  slow_motion;   // Whether slow-motion mode is active
    float slow_factor;   // Speed multiplier applied in slow-motion mode

    Ball guiBalls[MAX_BALLS];          // Ball parameters as set in the GUI
    Ball simBalls[MAX_BALLS];          // Ball state during active simulation
    Ball savedInitialBalls[MAX_BALLS]; // Snapshot of initial state for reset

    float gui_speed[MAX_BALLS];      // Speed values for speed/angle input mode
    float gui_angle_deg[MAX_BALLS];  // Angle values for speed/angle input mode
    bool  gui_use_speedangle[MAX_BALLS]; // Whether to use speed/angle or vx/vy

    int   guiBallCount;   // Number of balls currently configured
    float guiGravity;     // Gravity value set in the GUI

    bool  guiTimedRun;      // Whether the simulation stops after a fixed time
    float guiRunDuration;   // Duration for timed runs (seconds)
    float simElapsed;       // Time elapsed in the current simulation run

    float guiScrollOffset;  // Current vertical scroll position of the ball controls panel
} SimulationController;

// ============================================================================
// FUNCTION PROTOTYPES
// ============================================================================

void init_simulation_controller(SimulationController *sim);

void handle_input(SimulationController *sim);
void update_physics(SimulationController *sim, float dt);

void draw_simulation_area(SimulationController *sim, int simWidth, int screenHeight);
void draw_control_panel(SimulationController *sim, int simWidth, int screenHeight, int panelWidth);

void draw_panel_background(int px, int screenHeight, int panelWidth);
void draw_ball_count_controls(SimulationController *sim, int px, int *y);
void draw_simulation_buttons(SimulationController *sim, int px, int *y, int panelWidth);
void draw_global_controls(SimulationController *sim, int px, int *y, int panelWidth);
void draw_run_mode_controls(SimulationController *sim, int px, int *y, int panelWidth);
void draw_ball_controls(SimulationController *sim, int px, int *y, int panelWidth, int screenHeight);
void draw_energy_display(SimulationController *sim, int px, int screenHeight);

void draw_mass_control(SimulationController *sim, int i, int px, int *y, int panelWidth);
void draw_radius_control(SimulationController *sim, int i, int px, int *y, int panelWidth);
void draw_restitution_control(SimulationController *sim, int i, int px, int *y, int panelWidth);
void draw_velocity_mode_toggle(SimulationController *sim, int i, int px, int *y);
void draw_speed_angle_controls(SimulationController *sim, int i, int px, int *y, int panelWidth);
void draw_velocity_vector_controls(SimulationController *sim, int i, int px, int *y, int panelWidth);

// ============================================================================
// INITIALISATION
// ============================================================================

/**
 * Initialises the SimulationController to sensible default values.
 * All balls start at rest in the centre of the simulation box.
 * Called once before the main loop begins.
 */
void init_simulation_controller(SimulationController *sim) {
    sim->simState    = CONFIGURATION;
    sim->paused      = false;
    sim->show_vectors = true;
    sim->slow_motion = false;
    sim->slow_factor = 0.2f;

    sim->simElapsed    = 0.0f;
    sim->guiTimedRun   = false;
    sim->guiRunDuration = 10.0f;
    sim->guiScrollOffset = 0.0f;

    sim->guiBallCount = 1;
    sim->guiGravity   = GRAVITY;

    for (int i = 0; i < MAX_BALLS; i++) {
        sim->guiBalls[i].x           = WIDTH/2.0f + i*2.0f;
        sim->guiBalls[i].y           = HEIGHT/2.0f;
        sim->guiBalls[i].velocityx   = 0;
        sim->guiBalls[i].velocityy   = 0;
        sim->guiBalls[i].mass        = 1.0f;
        sim->guiBalls[i].restitution = 0.8f;
        sim->guiBalls[i].radius      = 0.5f;

        sim->simBalls[i]        = sim->guiBalls[i];
        sim->savedInitialBalls[i] = sim->guiBalls[i];

        sim->gui_use_speedangle[i] = true;
        sim->gui_speed[i]          = 0.0f;
        sim->gui_angle_deg[i]      = 0.0f;
    }

    reset_trails_for_num(sim->guiBallCount);
}

// ============================================================================
// INPUT
// ============================================================================

/**
 * Handles keyboard shortcuts each frame:
 *   V — toggle velocity / acceleration vector overlay
 *   S — toggle slow-motion mode
 *   Space — pause / resume (only while running)
 */
void handle_input(SimulationController *sim) {
    if (IsKeyPressed(KEY_V))     sim->show_vectors = !sim->show_vectors;
    if (IsKeyPressed(KEY_S))     sim->slow_motion  = !sim->slow_motion;
    if (IsKeyPressed(KEY_SPACE) && sim->simState == RUNNING)
        sim->paused = !sim->paused;
}

// ============================================================================
// PHYSICS UPDATE
// ============================================================================

/**
 * Advances the simulation by dt seconds.
 * Does nothing if the simulation is not running or is paused.
 *
 * Uses 4 substeps per frame for improved collision stability —
 * each substep integrates at sub_dt = dt/4.
 *
 * In slow-motion mode the effective timestep is scaled down by slow_factor.
 *
 * If a timed run is active, checks whether the elapsed time has
 * reached the configured duration and resets to CONFIGURATION if so.
 */
void update_physics(SimulationController *sim, float dt) {
    if (sim->simState != RUNNING || sim->paused) return;

    float effective_dt = sim->slow_motion ? dt * sim->slow_factor : dt;

    int   substeps = 4;
    float sub_dt   = effective_dt / (float)substeps;

    for (int s = 0; s < substeps; s++)
        simulation_step(sim->simBalls, sim->guiBallCount, sub_dt);

    if (sim->guiTimedRun) {
        sim->simElapsed += effective_dt;

        if (sim->simElapsed >= sim->guiRunDuration) {
            sim->simState = CONFIGURATION;
            sim->paused   = false;

            for (int i = 0; i < sim->guiBallCount; i++) {
                sim->guiBalls[i] = sim->savedInitialBalls[i];
                sim->simBalls[i] = sim->savedInitialBalls[i];

                // Restore GUI speed/angle display from saved velocities
                sim->gui_speed[i] = sqrtf(
                    sim->guiBalls[i].velocityx * sim->guiBalls[i].velocityx +
                    sim->guiBalls[i].velocityy * sim->guiBalls[i].velocityy);
                sim->gui_angle_deg[i] = atan2f(
                    sim->guiBalls[i].velocityy,
                    sim->guiBalls[i].velocityx) * 180.0f / (float)M_PI;
                sim->gui_use_speedangle[i] = true;
            }

            reset_trails_for_num(sim->guiBallCount);
            sim->simElapsed = 0.0f;
        }
    }
}

// ============================================================================
// SIMULATION AREA RENDERING
// ============================================================================

/**
 * Draws the left-hand simulation viewport:
 *   - Light grey background with border lines.
 *   - Trail dots for each ball (skips uninitialised positions marked -1).
 *   - Balls as filled circles scaled to their radius.
 *   - Optional velocity vector (blue) and gravity vector (green) overlays.
 *
 * In CONFIGURATION mode, guiBalls are drawn so the user can preview
 * starting positions. In RUNNING mode, simBalls are drawn.
 *
 * In CONFIGURATION + speed/angle mode, the velocity vector is computed
 * from gui_speed and gui_angle_deg rather than from velocityx/vy directly.
 */
void draw_simulation_area(SimulationController *sim, int simWidth, int screenHeight) {
    float scaleX = (float)simWidth  / (float)WIDTH;
    float scaleY = (float)screenHeight / (float)HEIGHT;

    DrawRectangle(0, 0, simWidth, screenHeight, LIGHTGRAY);
    DrawLine(0, screenHeight,   simWidth, screenHeight, BLACK);
    DrawLine(0, 0,              0,        screenHeight, BLACK);
    DrawLine(simWidth - 1, 0,   simWidth - 1, screenHeight, BLACK);

    // Trails
    for (int b = 0; b < sim->guiBallCount; b++) {
        for (int t = 0; t < TRAIL_LENGTH; t++) {
            if (trail_x[b][t] < 0) continue;
            int px = (int)(trail_x[b][t] * scaleX);
            int py = (int)(screenHeight - trail_y[b][t] * scaleY);
            if (px >= 0 && px < simWidth && py >= 0 && py < screenHeight)
                DrawCircle(px, py, 2.0f, GRAY);
        }
    }

    // Balls and optional vector overlays
    Ball *drawBalls = (sim->simState == RUNNING) ? sim->simBalls : sim->guiBalls;

    for (int i = 0; i < sim->guiBallCount; i++) {
        float x = drawBalls[i].x * scaleX;
        float y = screenHeight - drawBalls[i].y * scaleY;
        float r = drawBalls[i].radius * ((scaleX + scaleY) * 0.5f);

        DrawCircle((int)x, (int)y, r, RED);

        if (sim->show_vectors) {
            float vx = drawBalls[i].velocityx;
            float vy = drawBalls[i].velocityy;

            // In config + speed/angle mode, derive velocity from GUI inputs
            if (sim->simState == CONFIGURATION && sim->gui_use_speedangle[i]) {
                float angle = sim->gui_angle_deg[i] * DEG2RAD;
                vx = sim->gui_speed[i] * cosf(angle);
                vy = sim->gui_speed[i] * sinf(angle);
            }

            // Velocity arrow (blue) — vy negated because screen Y is flipped
            DrawLine((int)x, (int)y,
                     (int)(x + vx * 5.0f), (int)(y - vy * 5.0f), BLUE);

            // Gravity arrow (green)
            DrawLine((int)x, (int)y,
                     (int)x, (int)(y - sim->guiGravity * 2.0f), GREEN);
        }
    }
}

