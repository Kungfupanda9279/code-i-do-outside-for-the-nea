        sprintf(buf, "Mass: %.2f  Rest: %.2f  R: %.2f", guiBalls[ball_index].mass,
                guiBalls[ball_index].restitution, guiBalls[ball_index].radius);
        DrawText(buf, px + 12, *y, 12, DARKGRAY);
