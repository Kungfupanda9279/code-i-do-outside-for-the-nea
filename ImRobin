        DrawText(buf, px + 12, *y, 12, DARKGRAY);
        *y += 22;
    }

    *y += 6;
    if (*y > 720 - 120) {
        DrawText("...more controls off-screen", px + 12, 720 - 100, 10, DARKGRAY);
    }
}

