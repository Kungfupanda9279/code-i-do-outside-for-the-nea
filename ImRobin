        GuiSlider((Rectangle){px + 12, (float)(*y + 14), panelWidth - 24, 18}, NULL, NULL,
                  &guiBalls[ball_index].mass, 0.1f, 500.0f);
        *y += 38;

        // Restitution
        char rlabel[64];
        sprintf(rlabel, "Restitution %.2f", guiBalls[ball_index].restitution);
        DrawText(rlabel, px + 12, *y, 12, DARKGRAY);
        GuiSlider((Rectangle){px + 12, (float)(*y + 14), panelWidth - 24, 18}, NULL, NULL,
                  &guiBalls[ball_index].restitution, 0.0f, 1.0f);
        *y += 38;

        // Radius
        char radlabel[64];
        sprintf(radlabel, "Radius %.2f", guiBalls[ball_index].radius);
        DrawText(radlabel, px + 12, *y, 12, DARKGRAY);
        GuiSlider((Rectangle){px + 12, (float)(*y + 14), panelWidth - 24, 18}, NULL, NULL,
                  &guiBalls[ball_index].radius, 0.05f, 5.0f);
        *y += 38;

        // Velocity mode checkbox
        GuiCheckBox((Rectangle){px+12, (float)(*y), 20, 20}, NULL, &gui_use_speedangle[ball_index]);
        DrawText(gui_use_speedangle[ball_index] ? "Speed & Angle" : "Vx & Vy", px + 36, *y, 12, DARKGRAY);
        *y += 24;

        if (gui_use_speedangle[ball_index]) {
            char sLabel[64], aLabel[64];
            sprintf(sLabel, "Speed %.2f", gui_speed[ball_index]);
            DrawText(sLabel, px + 12, *y, 12, DARKGRAY);
            GuiSlider((Rectangle){px + 12, (float)(*y + 14), panelWidth - 24, 18}, NULL, NULL,
                      &gui_speed[ball_index], 0.0f, 200.0f);
            *y += 38;

            sprintf(aLabel, "Angle %.1f deg", gui_angle_deg[ball_index]);
            DrawText(aLabel, px + 12, *y, 12, DARKGRAY);
            GuiSlider((Rectangle){px + 12, (float)(*y + 14), panelWidth - 24, 18}, NULL, NULL,
                      &gui_angle_deg[ball_index], -180.0f, 180.0f);
            *y += 38;

            float a_rad = gui_angle_deg[ball_index] * M_PI / 180.0f;
            guiBalls[ball_index].velocityx = gui_speed[ball_index] * cosf(a_rad);
            guiBalls[ball_index].velocityy = gui_speed[ball_index] * sinf(a_rad);

        } else {
            char vxLabel[64], vyLabel[64];
            sprintf(vxLabel, "vx %.2f", guiBalls[ball_index].velocityx);
            sprintf(vyLabel, "vy %.2f", guiBalls[ball_index].velocityy);
            DrawText(vxLabel, px + 12, *y, 12, DARKGRAY);
            GuiSlider((Rectangle){px + 12, (float)(*y + 14), panelWidth - 24, 18}, NULL, NULL,
                      &guiBalls[ball_index].velocityx, -200.0f, 200.0f);
            *y += 38;
            DrawText(vyLabel, px + 12, *y, 12, DARKGRAY);
            GuiSlider((Rectangle){px + 12, (float)(*y + 14), panelWidth - 24, 18}, NULL, NULL,
                      &guiBalls[ball_index].velocityy, -200.0f, 200.0f);
