// ---------------------- Main run function ---------------------------------
void run_raylib_simulation(Ball initialBalls[], float dt, int max_frames)
{
    SimulationController sim = {0};

    // copy initialBalls
    for (int i = 0; i < MAX_BALLS; i++) {
        if (i < num_balls) {
            sim.guiBalls[i] = initialBalls[i];
            sim.simBalls[i] = initialBalls[i];
            sim.savedInitialBalls[i] = initialBalls[i];
        } else {
            sim.guiBalls[i].x = WIDTH/2.0f + i*2.0f;
            sim.guiBalls[i].y = HEIGHT/2.0f;
            sim.guiBalls[i].mass = 1.0f;
            sim.guiBalls[i].restitution = 0.8f;
            sim.guiBalls[i].radius = 0.5f;
            sim.guiBalls[i].velocityx = 0.0f;
            sim.guiBalls[i].velocityy = 0.0f;
            sim.simBalls[i] = sim.guiBalls[i];
            sim.savedInitialBalls[i] = sim.guiBalls[i];
        }
        sim.gui_use_speedangle[i] = true;
        sim.gui_speed[i] = sqrtf(sim.guiBalls[i].velocityx*sim.guiBalls[i].velocityx + sim.guiBalls[i].velocityy*sim.guiBalls[i].velocityy);
        sim.gui_angle_deg[i] = atan2f(sim.guiBalls[i].velocityy, sim.guiBalls[i].velocityx) * 180.0f / M_PI;
    }

    sim.guiBallCount = (num_balls > 0) ? num_balls : 1;
    sim.simState = CONFIGURATION;
    sim.paused = false;
    sim.show_vectors = true;
    sim.slow_motion = false;
    sim.guiTimedRun = false;
    sim.guiRunDuration = 10.0f;
    sim.simElapsed = 0.0f;
    sim.guiGravity = GRAVITY;

    reset_trails_for_num(sim.guiBallCount);

    InitWindow(1024, 720, "Multi-Ball Physics Simulator");
    SetTargetFPS(60);

    int frame = 0;
    while (!WindowShouldClose() && (max_frames <= 0 || frame < max_frames))
    {
        handle_input(&sim);
        update_physics(&sim, dt);

        BeginDrawing();
        ClearBackground(RAYWHITE);

        draw_simulation_area(&sim, 1024-320, 720);
        draw_control_panel(&sim, 1024-320, 720, 320);

        EndDrawing();

        // add trails sample while running
        if (sim.simState == RUNNING && !sim.paused) {
            for (int b = 0; b < sim.guiBallCount; b++) update_trail(&sim.simBalls[b], b);
        }

        frame++;
    }

    CloseWindow();
}




